{
  "name": "dsh-withssh",
  "version": "0.1.0",
  "description": "Session-scoped SSH console for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhwu1/dsh-withSsh.git"
  },
  "bugs": "https://github.com/lhwu1/dsh-withSsh/issues",
  "homepage": "https://github.com/lhwu1/dsh-withSsh#readme",
  "keywords": ["deepseek-harness", "dsh", "ssh", "terminal", "plugin"],
  "license": "MIT",
  "type": "module",
  "main": "lib/host/index.mjs",
  "types": "lib/host/index.d.mts",
  "exports": {
    ".": { "types": "./lib/host/index.d.mts", "default": "./lib/host/index.mjs" },
    "./web": { "types": "./lib/host/web.d.mts", "default": "./lib/host/web.mjs" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["docs/", "lib/", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "scripts": {
    "prepack": "npm run validate",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run build"
  },
  "engines": { "node": ">=22.19" },
  "dependencies": { "ssh2": "^1.16.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "file:../deepseek-harness-master/vendor/cordis",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.0",
    "@types/ssh2": "^1.15.5",
    "react": "^18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.5.0"
  }
}
